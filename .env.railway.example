# Paste into Junta > Variables > Raw Editor, not into the local .env.
# Replace APP_KEY privately and keep it unchanged across redeploys.
# Railway reference expressions require a database service named MySQL.
APP_NAME=Junta
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_DEMO_MODE=true
APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT
# Match the Railway public domain target port; the runtime accepts any PORT.
PORT=8080
# Use only behind the Railway HTTPS ingress; expose only the Nginx port.
TRUSTED_PROXIES=*
INERTIA_SSR_ENABLED=false

LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
CACHE_PREFIX=junta-railway-
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Internal test inbox; sends no real email. Access through SSH only.
MAIL_CAPTURE_ENABLED=true
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@junta.test
MAIL_FROM_NAME=Junta

# Demonstration settings: synthetic payments only, no paid APIs.
OPENAI_ENABLED=false
PURCHASE_PAYMENT_PROVIDER=test
PURCHASE_TEST_ENABLED=true
PURCHASE_UNCERTAIN_ESCALATION_MINUTES=30
