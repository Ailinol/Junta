# Copy to .env.production; keep it private. Compose uses --env-file explicitly.
COMPOSE_PROJECT_NAME=junta
APP_IMAGE=junta-app:production
WEB_IMAGE=junta-web:production
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

APP_NAME=Junta
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DEMO_MODE=false
# Replace with the HTTPS address assigned by the actual ingress.
APP_URL=https://junta.example.invalid
APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# Comma-separated IPs/CIDRs of the actual TLS proxy as seen by PHP.
# Leave empty until confirmed; never use * on a publicly reachable origin.
TRUSTED_PROXIES=
INERTIA_SSR_ENABLED=false

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=junta
DB_USERNAME=junta
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# For managed MySQL, mount its CA and set this absolute container path.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=junta-production-
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# log does not deliver email. Configure an existing free SMTP service for
# verification and password reset before declaring those flows operational.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_TIMEOUT=30
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME=Junta

# No paid services are activated. Existing business restrictions are preserved.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_TIMEOUT=25
PURCHASE_PAYMENT_PROVIDER=disabled
PURCHASE_TEST_ENABLED=false
PURCHASE_TEST_WEBHOOK_SECRET=
PURCHASE_UNCERTAIN_ESCALATION_MINUTES=30
VITE_APP_NAME=Junta
